{
    "name": "__MSG_extName__",
    "description": "__MSG_extDesc__",
    "default_locale": "en",
    "version": "1.0",
    "manifest_version": 2,
    "browser_specific_settings": {
        "gecko": {
            "id": "puppify@suprstarrd.com",
            "strict_min_version": "78.0"
        },
        "gecko_android": {
            "strict_min_version": "79.0"
        }
    },
    "minimum_chrome_version": "87",
    "minimum_opera_version": "74",
    "background": {
        "scripts": [ "background.js" ],
        "persistent": false
    },
    "web_accessible_resources": [
        {
            "resources": [ "_locales/*/messages.json" ],
            "matches": [ "<all_urls>" ]
        }
    ],
    "permissions": [
        "storage",
        "activeTab"
    ],
    "optional_host_permissions": [
        "<all_urls>"
    ],
    "icons": {
        "512": "icons/puppy/512.png",
        "256": "icons/puppy/256.png",
        "192": "icons/puppy/192.png",
        "128": "icons/puppy/128.png",
        "96": "icons/puppy/96.png",
        "72": "icons/puppy/72.png",
        "64": "icons/puppy/64.png",
        "48": "icons/puppy/48.png",
        "32": "icons/puppy/32.png",
        "16": "icons/puppy/16.png"
    },
    "options_page": "options.html",
    "action": {}
}